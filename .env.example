# =====================================================
# Frontend Environment Variables — Sintra / Bapperida
# Copy file ini menjadi .env.local untuk development lokal
# Set nilai aslinya di Vercel Dashboard > Project Settings > Environment Variables
# =====================================================

# URL backend Render kamu (tanpa trailing slash)
# Dapatkan dari Render Dashboard setelah deploy backend
# Contoh: https://sintra-backend.onrender.com
VITE_API_BASE_URL=https://NAMA-BACKENDMU.onrender.com

# =====================================================
# Menu "AI Agen Chatbot RKA" (modul Chatbot Bapperida / cbb)
# PERHATIAN: semua variabel VITE_* ikut tertanam di bundle JavaScript dan
# bisa dibaca siapa pun lewat browser. Jangan isi dengan kunci produksi yang
# tidak dibatasi. Kosongkan untuk memakai jawaban knowledge base lokal saja,
# atau isi lewat menu "Sematkan ke Web" > "Pengaturan API LLM" (localStorage).
# =====================================================
VITE_GEMINI_API_KEY=
